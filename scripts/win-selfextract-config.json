{
  "appId": "de.radimo.agent",
  "productName": "RadimoAgent",
  "asar": true,
  "files": [
    "src/**/*",
    "assets/**/*",
    "package.json",
    "README.md",
    "README-DE.md",
    "docs/**/*",
    "guidance/**/*",
    "AGENTS.md"
  ],
  "extraResources": [
    {
      "from": "vendor/codex/win-x64",
      "to": "codex",
      "filter": ["codex.exe"]
    }
  ],
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "assets/radimoagent.ico",
    "signAndEditExecutable": false,
    "artifactName": "RadimoAgent-${version}-win-${arch}-selfextract.${ext}"
  }
}
