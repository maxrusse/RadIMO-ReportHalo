{
  "appId": "de.radimo.reporthalo.fieldmapper",
  "productName": "RadIMO - ReportHalo Field Mapper",
  "directories": { "output": "dist-field-mapper" },
  "asar": true,
  "electronLanguages": ["en-US", "de"],
  "extraMetadata": { "main": "src/field-mapper-main.js" },
  "files": [
    "src/field-mapper-main.js",
    "src/field-mapper-preload.js",
    "src/field-mapper.html",
    "src/field-mapper.js",
    "src/field-mapper.css",
    "src/windows-field-bridge.js",
    "src/windows-field-mapper.js",
    "package.json",
    "assets/radimoagent.ico",
    "EULA.txt",
    "THIRD-PARTY-NOTICES.md",
    "LICENSES/**/*"
  ],
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "assets/radimoagent.ico",
    "signAndEditExecutable": false,
    "artifactName": "RadIMO-ReportHalo-FieldMapper-${version}-win-${arch}.${ext}"
  }
}
