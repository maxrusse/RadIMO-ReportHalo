{
  "appId": "de.radimo.agent.api",
  "productName": "RadIMO - ReportHalo API",
  "directories": { "output": "dist-api" },
  "asar": true,
  "electronLanguages": ["de", "en-US"],
  "extraMetadata": { "radimoBackend": "api" },
  "files": [
    "src/**/*",
    "!src/codex-app-server.js",
    "!src/platform.js",
    "!src/codex-proxy-env.js",
    "!src/windows-field-bridge.js",
    "!src/windows-safe-field-bridge.js",
    "!src/field-mapper-main.js",
    "!src/field-mapper-preload.js",
    "!src/field-mapper.html",
    "!src/field-mapper.js",
    "!src/field-mapper.css",
    "assets/**/*",
    "package.json",
    "codex-runtime.json",
    "README.md",
    "README-DE.md",
    "EULA.txt",
    "guidance/**/*",
    "THIRD-PARTY-NOTICES.md",
    "LICENSES/**/*",
    "!vendor/**/*"
  ],
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "assets/radimoagent.ico",
    "signAndEditExecutable": false,
    "artifactName": "RadIMO-ReportHalo-${version}-win-${arch}-api.${ext}"
  }
}
